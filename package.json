  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:check": "NEXT_DIST_DIR=.next-build next build",
    "tokens": "node scripts/export-tokens.mjs",
    "scrape": "node scripts/scrape.mjs",
    "qa:static": "npm run typecheck && npm run lint && npm run build:check",
    "qa:audit": "node scripts/qa/audit.mjs",
    "qa:reveal": "node scripts/qa/reveal-stress.mjs",
    "qa:shader": "node scripts/qa/shader-stress.mjs",
    "qa:shots": "node scripts/qa/shoot.mjs",
    "qa": "npm run qa:static && npm run qa:audit -- --sample=4 && npm run qa:reveal && npm run qa:shader"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
